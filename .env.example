# ---- Core ----
APP_NAME=AdPulse
BASE_URL=http://localhost:8000              # your public https URL in production (automatic on Render)
DATABASE_PATH=./data/adpulse.db             # local SQLite file (used when DATABASE_URL is blank)
DATABASE_URL=                               # Postgres/Supabase connection string; when set, data is stored there
CRON_SECRET=                                # optional: lets an external scheduler call /tasks/sync?key=...
# Encrypts saved logins. Any long random string; required with DATABASE_URL. Never change it after first use.
SECRET_KEY=
DEMO_MODE=true                              # seeds demo agency on first run; set false in production
SYNC_INTERVAL_MINUTES=60                    # 0 = disable in-process scheduler (use cron: python -m app.cli sync)
TRAILING_WINDOW_DAYS=28                     # re-pull window to catch late conversion restatements
BACKFILL_DAYS=120
EVENT_RETENTION_DAYS=395

# ---- B2B company identification (optional) ----
# IPinfo token on a plan that includes company data. Only business/education/government networks are kept; raw IPs are never stored.
IPINFO_TOKEN=

# ---- Prospect audits (optional) ----
PAGESPEED_API_KEY=                          # Google PageSpeed Insights key for performance scores (works without, at low quota)

# ---- Alert notifications (optional) ----
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ---- Google (Ads, GA4, Search Console, Business Profile) ----
# OAuth client (Web application) in Google Cloud; redirect URI: {BASE_URL}/oauth/google/callback
# Google Ads API access: Cloud Console > your project > Google Ads API page > request Basic access (needs brand verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=                 # leave blank: since Sept 2026 access is granted to your Cloud project (Google Ads API page in Cloud Console)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=               # your MCC id, digits only
GOOGLE_ADS_API_VERSION=v21                  # bump when Google sunsets versions

# ---- Meta (Marketing API) ----
# App with Marketing API product; Business Verification + App Review for ads_read/ads_management
# redirect URI: {BASE_URL}/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0

# ---- TikTok for Business (Marketing API) ----
# redirect URI: {BASE_URL}/oauth/tiktok/callback
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ---- LinkedIn (Advertising API / Marketing Developer Platform) ----
# redirect URI: {BASE_URL}/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202509                 # YYYYMM; LinkedIn retires versions after ~1 year
